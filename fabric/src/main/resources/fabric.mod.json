{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/peaceful-hunger",
        "sources": "https://github.com/Mods-For-Lupin/Peaceful-Hunger"
    },
    "license": "${license}",
    "icon": "peaceful_hunger.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.cursee.peaceful_hunger.PeacefulHungerFabric"
        ],
        "client": [
            "com.cursee.peaceful_hunger.PeacefulHungerClientFabric"
        ]
    },
    "mixins": [
        "peaceful_hunger.mixins.json",
        "peaceful_hunger.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  